# Exemplo sem segredos para homologacao. Configure os valores reais apenas nos
# cofres do Render, Vercel e Supabase.
DATABASE_ENV=homologation
DATABASE_URL=SET_IN_RENDER_SECRET_STORE
MIGRATION_DATABASE_URL=SET_ONLY_DURING_MANUAL_MIGRATION
DATABASE_SSL_REQUIRED=true
DATABASE_ECHO=false
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=300

PUBLIC_DEMO_MODE=true
API_DOCS_ENABLED=false
ALLOWED_HOSTS=sigra-api-homolog.onrender.com
CORS_ALLOWED_ORIGINS=https://FRONTEND_PROJECT.vercel.app
FIPE_AUTO_REFRESH=false

# Variaveis de build do frontend no Vercel.
VITE_API_URL=https://sigra-api-homolog.onrender.com
VITE_PUBLIC_DEMO_MODE=true

# Somente para executar o Playwright contra a homologacao ja publicada.
PLAYWRIGHT_BASE_URL=https://FRONTEND_PROJECT.vercel.app
E2E_API_URL=https://sigra-api-homolog.onrender.com
E2E_EXTERNAL_ENVIRONMENT=true
