# Backend: development | test | integration | production
DATABASE_ENV=development

# Desenvolvimento SQLite. Caminhos relativos sao resolvidos a partir de backend.
DATABASE_URL=sqlite:///./sigra.db

# PostgreSQL local (docker-compose.postgres.yml):
# DATABASE_ENV=integration
# DATABASE_URL=postgresql+psycopg://sigra@127.0.0.1:5432/sigra_integration
# TEST_POSTGRESQL_URL=postgresql+psycopg://sigra@127.0.0.1:5432/sigra_integration
# SIGRA_RUN_POSTGRES_TESTS=1
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=sigra
# PGPASSWORD=sigra_dev_only
# PGDATABASE=sigra_integration
# DATABASE_WAIT_TIMEOUT_SECONDS=60

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Override somente para recuperacao emergencial documentada. Production rejeita
# SQLite por padrao.
ALLOW_SQLITE_IN_PRODUCTION=false

# Variaveis de desenvolvimento do Docker Compose. Nao reutilize em producao.
POSTGRES_DB=sigra_dev
POSTGRES_USER=sigra
POSTGRES_PASSWORD=sigra_dev_only
POSTGRES_PORT=5432

# Atualizacao mensal de precos FIPE por API intermediaria, com cache local.
FIPE_API_URL=https://fipe.parallelum.com.br/api/v2
FIPE_CACHE_TTL_HOURS=24
FIPE_HTTP_TIMEOUT_SECONDS=5
FIPE_AUTO_REFRESH=true

# Origens adicionais, explicitas e separadas por virgula. O curinga * e ignorado.
CORS_ALLOWED_ORIGINS=

# Limiar informativo para classificar uma simulacao como proxima do limite.
FINANCING_NEAR_LIMIT_PERCENTAGE=85

# Frontend
# Copie para frontend/.env.local se quiser apontar o Vite para outra API.
VITE_API_URL=http://127.0.0.1:8000
