# Unconfigured template. Enter secrets only in the provider's private env UI.
# Never run a shell with a full authenticated URL as an argument.
SIGRA_VERCEL_ENABLED=true
SIGRA_DEPLOY_ENABLED=true
DATABASE_ENV=homologation
DATABASE_SSL_REQUIRED=true
DATABASE_ECHO=false
DATABASE_BOOTSTRAP_SCHEMA=false
PUBLIC_DEMO_MODE=false
ACADEMIC_COHORT_ENABLED=true
FIPE_AUTO_REFRESH=false
API_DOCS_ENABLED=false
SIGRA_COOKIE_SECURE=true
SIGRA_COOKIE_SAMESITE=lax
SIGRA_REVISION6_HOMOLOGATION_ENABLED=false
SIGRA_DERIVED_PERSONALIZATION_ENABLED=true
SIGRA_RESEARCH_COLLECTION_ENABLED=false
SIGRA_TCC_COLLECTION_MODE=homologation
SIGRA_DEPLOY_PLAN_SHA256=cb70ff5298ffc4c52fc74e44588b2e34a39584b4cacfa6146981670737f3be97
# Set to the candidate release ID in release/manifest.json, not the old image ID.
SIGRA_SYSTEM_VERSION=
# Exactly one assigned https://HOST.vercel.app, no trailing slash or wildcard.
SIGRA_PUBLIC_ORIGIN=
SIGRA_VERCEL_EXACT_HOST=
CORS_ALLOWED_ORIGINS=
ALLOWED_HOSTS=
# Keep absent: SIGRA_TRUSTED_PROXY_IPS (no Uvicorn TCP proxy on this path).
# PRIVATE: runtime role only, URL-encoded, exact approved endpoint :5432,
# database sigra_tcc_research, sslmode=verify-full&sslrootcert=SIGRA_CA_FILE.
DATABASE_URL=
SIGRA_RESEARCH_PSEUDONYM_KEY=
# Base64 is encoding, NOT encryption. These values must remain private too.
# Real target receipt bytes + real CA, obtained only after provisioning/approval.
SIGRA_VERCEL_TARGET_B64=
SIGRA_DEPLOY_TARGET_SHA256=
SIGRA_VERCEL_CA_B64=
# Do NOT set operator/migration URLs or VERCEL_SUPPORT_LARGE_FUNCTIONS=1.
