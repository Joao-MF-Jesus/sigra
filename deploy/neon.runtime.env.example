# PUBLIC UNCONFIGURED TEMPLATE. Not a valid configuration; do not source it yet.
# Retain the flags in vercel.runtime.env.example and supply the NEW release ID.
SIGRA_DEPLOY_PROVIDER=neon
# Preview only: exact assigned VERCEL_URL, project ID and team ID pinned in target.
# Existing explicit-host-v1 mode remains available; no automatic origin fallback.
SIGRA_VERCEL_ORIGIN_MODE=system-preview-v1
SIGRA_VERCEL_EXPECTED_PROJECT_ID=
SIGRA_VERCEL_EXPECTED_TEAM_ID=
# Optional counts only, scoped to the accepted fictitious Neon target.
# Result-field bytes exclude protocol/TLS and are not provider egress.
SIGRA_NEON_PREVIEW_METRICS=true
SIGRA_NEON_TRANSPORT_MODEL=neon-managed-preview-v1
SIGRA_NEON_TRANSPORT_ACCEPTANCE_SHA256=8d278f21d9bc4e8be02b06f2e88ef0d3542acc07a2c2b99454cd36c6d7d4e839
SIGRA_NEON_ORGANIZATION_ID=
SIGRA_NEON_PROJECT_ID=
SIGRA_NEON_BRANCH_ID=
SIGRA_NEON_ENDPOINT_ID=
SIGRA_NEON_HOST=
SIGRA_NEON_DATABASE_OID=
SIGRA_NEON_DATABASE_COMMENT=
# Only exact observed host, runtime role and new database; no IP/hostaddr overrides.
# Native: absolute real CA path. Vercel: literal sslrootcert=SIGRA_CA_FILE.
# Query keys exactly: sslmode=verify-full, sslrootcert=..., sslsni=1, channel_binding=require.
DATABASE_URL=
# New stable key for the fictitious Neon dataset, never the TLS A/B key.
SIGRA_RESEARCH_PSEUDONYM_KEY=
# Vercel private Preview variables; native tools use pinned absolute file paths.
SIGRA_VERCEL_TARGET_B64=
SIGRA_DEPLOY_TARGET_SHA256=
SIGRA_VERCEL_CA_B64=
# Native operator-only terminal: SIGRA_RESEARCH_MIGRATION_URL (owner, not runtime).
# Never install that owner URL or the Neon provisioner credential in Vercel.
# Required unchanged: SIGRA_RESEARCH_COLLECTION_ENABLED=false,
# SIGRA_TCC_COLLECTION_MODE=homologation, DATABASE_BOOTSTRAP_SCHEMA=false.
