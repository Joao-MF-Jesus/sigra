# Example only; never loaded automatically. Private values go in the host's vault.
SIGRA_DEPLOY_ENABLED=true
DATABASE_ENV=homologation
DATABASE_SSL_REQUIRED=true
DATABASE_ECHO=false
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
PUBLIC_DEMO_MODE=false
ACADEMIC_COHORT_ENABLED=true
FIPE_AUTO_REFRESH=false
API_DOCS_ENABLED=false
SIGRA_COOKIE_SECURE=true
SIGRA_COOKIE_SAMESITE=lax
SIGRA_REVISION6_HOMOLOGATION_ENABLED=false
# Base/Ampliada already accepted; explicit choice remains in the interface.
SIGRA_DERIVED_PERSONALIZATION_ENABLED=true
# Remains false for every prepared/published fictitious smoke. No automatic arming.
SIGRA_RESEARCH_COLLECTION_ENABLED=false
SIGRA_TCC_COLLECTION_MODE=homologation
# Fill exact HTTPS origin/host after allocating the service, no wildcard or slash.
SIGRA_PUBLIC_ORIGIN=
CORS_ALLOWED_ORIGINS=
ALLOWED_HOSTS=
# Exact proxy CIDRs observed/documented for the host, not '*'. One worker only.
SIGRA_TRUSTED_PROXY_IPS=
SIGRA_DEPLOY_TARGET_FILE=/etc/secrets/sigra-target.json
SIGRA_DEPLOY_TARGET_SHA256=
SIGRA_FUNCTIONAL_ACCEPTANCE_FILE=/app/release/functional-acceptance.json
SIGRA_DEPLOY_PLAN_FILE=/app/release/plan.json
SIGRA_DEPLOY_PLAN_SHA256=
# PRIVATE, mandatory: postgresql+psycopg URL with verify-full and sslrootcert.
DATABASE_URL=
# PRIVATE: preserve the existing approved key; do not regenerate on each deploy.
SIGRA_RESEARCH_PSEUDONYM_KEY=
# SIGRA_SYSTEM_VERSION and manifest path are derived from the frozen artifact.
# NEVER configure MIGRATION_DATABASE_URL or SIGRA_REVISION6_MIGRATION_URL in web.
