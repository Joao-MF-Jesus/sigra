# Example only. Load via your local secret mechanism; never commit the real URL.
# Set DATABASE_URL to the existing application target ONLY after the migration
# is explicitly authorized and validated on a separate disposable database.
DATABASE_ENV=integration
DATABASE_URL=
MIGRATION_DATABASE_URL=
SIGRA_TCC_TEST_DATABASE_URL=
SIGRA_SYSTEM_VERSION=
SIGRA_COOKIE_SECURE=true
SIGRA_COOKIE_SAMESITE=lax
# Private stable random value, at least 32 bytes; required for pseudonymous CSV.
SIGRA_RESEARCH_PSEUDONYM_KEY=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
PUBLIC_DEMO_MODE=false
ACADEMIC_COHORT_ENABLED=true
FIPE_AUTO_REFRESH=false
# HTTP localhost testing ONLY: override SIGRA_COOKIE_SECURE=false in process.
# Frontend process:
VITE_API_URL=http://127.0.0.1:8010
VITE_PUBLIC_DEMO_MODE=false
