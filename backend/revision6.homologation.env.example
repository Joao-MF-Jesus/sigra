# Example only. No secrets. Do not load into the existing demo/backend process.
# A NEW empty dedicated PostgreSQL database must be provisioned externally first.
DATABASE_ENV=integration
SIGRA_REVISION6_HOMOLOGATION_ENABLED=false
SIGRA_REVISION6_CONFIRM_DATABASE=sigra_revision6_homologation_test
SIGRA_REVISION6_PARTICIPANTS=fictitious_only
SIGRA_REVISION6_MIGRATION_URL=
SIGRA_REVISION6_RUNTIME_URL=
# Hosted mode requires a real, healthy project confirmed through Management API.
# SIGRA_REVISION6_TARGET_KIND=supabase
# SIGRA_REVISION6_CONFIRM_PROJECT=<real-confirmed-project-ref>
# SIGRA_REVISION6_PROJECT_CONFIRMATION=<absolute-external-receipt-path>
# SIGRA_REVISION6_PROJECT_CONFIRMATION_SHA256=<receipt-sha256>
# Both private URLs: exact pinned direct/session endpoint, port 5432, verify-full.
# Session pooler wire usernames are <role>.<confirmed-project-ref>.
# external absolute sslrootcert, with CA bytes matching the confirmation.
DATABASE_URL=
SIGRA_REVISION6_TARGET_PROOF=
SIGRA_REVISION6_BUNDLE=
SIGRA_REVISION6_DECISION=
ACADEMIC_COHORT_ENABLED=true
SIGRA_TCC_COLLECTION_MODE=homologation
SIGRA_RESEARCH_PSEUDONYM_KEY=
SIGRA_DERIVED_PERSONALIZATION_ENABLED=false
FIPE_AUTO_REFRESH=false
DATABASE_ECHO=false
# Local HTTP only. A future HTTPS deployment must use true and exact HTTPS CORS.
SIGRA_COOKIE_SECURE=false
SIGRA_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://127.0.0.1:14185
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
