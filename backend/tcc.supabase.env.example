# EXAMPLE ONLY: every empty value must be supplied securely by the operator.
# Supabase is PostgreSQL hosting, NOT the authentication provider.
# Copy actual Connect URLs; choose direct or SESSION pooler, never port 6543.
SIGRA_TCC_HOMOLOGATION_PROJECT_REF=
SIGRA_TCC_DATABASE_HOST=
SIGRA_TCC_HOMOLOGATION_MIGRATION_URL=
SIGRA_TCC_HOMOLOGATION_RUNTIME_URL=
SIGRA_ACADEMIC_V6_REPLAY_PATH=
# Only set to the exact exclusive project ref when authorizing synthetic test records.
SIGRA_TCC_HOMOLOGATION_TEST_APPROVAL=
DATABASE_ENV=homologation
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_SSL_REQUIRED=true
DATABASE_ECHO=false
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
ACADEMIC_COHORT_ENABLED=true
PUBLIC_DEMO_MODE=false
FIPE_AUTO_REFRESH=false
API_DOCS_ENABLED=false
SIGRA_COOKIE_SECURE=true
SIGRA_COOKIE_SAMESITE=lax
SIGRA_RESEARCH_PSEUDONYM_KEY=
SIGRA_SYSTEM_VERSION=
# Homologation with synthetic participants only. Real collection is blocked.
SIGRA_TCC_COLLECTION_MODE=homologation
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
VITE_API_URL=
VITE_PUBLIC_DEMO_MODE=false
